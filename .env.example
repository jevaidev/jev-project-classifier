# Choose the same OpenRouter route used by jevai.dev.
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Alternative: direct TypeSafe API. Set JEV_PROVIDER=typesafe to use it.
TYPESAFE_API_KEY=

# Optional direct TypeSafe SDK overrides.
TYPESAFE_BASE_URL=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Raises GitHub API limits for discovery and metadata collection.
GITHUB_TOKEN=
